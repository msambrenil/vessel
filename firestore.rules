rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helpers de autenticación y propiedad
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Perfiles públicos de la matriz VESSEL (Lectura libre, escritura exclusiva del propietario)
    match /vessel_profiles/{profileId} {
      allow read: if true;
      allow write: if isOwner(profileId);
    }

    // Usuarios VESSEL: Expediente privado, límites, dossiers y álbumes (Privacidad estricta P0)
    match /vessel_users/{userId} {
      // Blindaje IDOR: Únicamente el dueño del UID puede leer y modificar sus datos privados
      allow read, write: if isOwner(userId);

      match /albums/{albumId} {
        allow read: if isOwner(userId) || (resource != null && resource.data.privacy == 'public');
        allow write: if isOwner(userId);
      }

      match /boundaries/{boundaryId} {
        allow read, write: if isOwner(userId);
      }

      match /dossiers/{dossierId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Helper para verificar participantes de chat de forma segura
    function isChatMember(chatId) {
      return isAuthenticated() && (
        (resource != null && resource.data.participants != null && request.auth.uid in resource.data.participants) ||
        (request.resource != null && request.resource.data.participants != null && request.auth.uid in request.resource.data.participants) ||
        chatId.matches('.*' + request.auth.uid + '.*')
      );
    }

    // Chats efímeros en tiempo real y darkroom (Acceso exclusivo para los participantes legítimos)
    match /vessel_chats/{chatId} {
      allow read: if isChatMember(chatId);
      allow create: if isChatMember(chatId);
      allow update, delete: if isChatMember(chatId);

      match /messages/{messageId} {
        allow read: if isAuthenticated() && (
          (resource != null && (resource.data.senderId == request.auth.uid || resource.data.recipientId == request.auth.uid)) ||
          chatId.matches('.*' + request.auth.uid + '.*')
        );
        // Anti-Spoofing P0: Solo el usuario autenticado puede ser el remitente legítimo del mensaje
        allow create: if isAuthenticated() &&
          request.resource.data.senderId == request.auth.uid &&
          (chatId.matches('.*' + request.auth.uid + '.*') || request.resource.data.recipientId != null);
        allow update: if isAuthenticated() && (
          chatId.matches('.*' + request.auth.uid + '.*') ||
          (resource != null && resource.data.senderId == request.auth.uid) ||
          request.resource.data.isBurned == true
        );
        allow delete: if isAuthenticated() && (
          chatId.matches('.*' + request.auth.uid + '.*') ||
          (resource != null && resource.data.senderId == request.auth.uid)
        );
      }
    }

    // Testimonios de encuentros con doble consentimiento
    match /vessel_testimonials/{testimonialId} {
      allow read: if true;
      allow create: if isAuthenticated() && (
        request.resource.data.authorUid == request.auth.uid ||
        request.resource.data.senderId == request.auth.uid
      );
      allow update, delete: if isAuthenticated() && (
        resource.data.authorUid == request.auth.uid ||
        resource.data.senderId == request.auth.uid
      );
    }

    // Identidades únicas (Anti-Sybil) y deduplicación - Privacidad estricta
    match /vessel_unique_identities/{identityId} {
      allow read: if isAuthenticated() && (
        identityId == 'user_' + request.auth.uid ||
        (resource != null && resource.data.uid == request.auth.uid)
      );
      allow create, update: if isAuthenticated() && (
        identityId == 'user_' + request.auth.uid ||
        (request.resource != null && request.resource.data.uid == request.auth.uid)
      );
      allow delete: if isAuthenticated() && (
        identityId == 'user_' + request.auth.uid ||
        (resource != null && resource.data.uid == request.auth.uid)
      );
    }

    // Lista negra de dispositivos y cuentas restringidas
    match /vessel_blacklist/{blacklistId} {
      allow read: if true;
      allow write: if false; // Solo administradores / Backend
    }

    // Pulsos cinéticos persistentes (Señales de radar en tiempo real)
    match /vessel_pulses/{pulseId} {
      allow read: if isAuthenticated() && (
        resource.data.toUid == request.auth.uid ||
        resource.data.fromUid == request.auth.uid
      );
      allow create: if isAuthenticated() &&
        request.resource.data.fromUid == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.toUid == request.auth.uid ||
        resource.data.fromUid == request.auth.uid
      );
      allow delete: if isAuthenticated() && (
        resource.data.toUid == request.auth.uid ||
        resource.data.fromUid == request.auth.uid
      );
    }

    // Hotspots tácticos y check-in anónimo (Lectura pública, actualización de afluencia en vivo)
    match /vessel_hotspots/{hotspotId} {
      allow read: if true;
      allow create: if isAuthenticated(); // Permite seed inicial
      allow update: if isAuthenticated(); // Permite check-in/out atómico
      allow delete: if false;
    }

    // Denegación por defecto para cualquier otra ruta no declarada
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
