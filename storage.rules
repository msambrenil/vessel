rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        (
          request.auth.token.email != null &&
          request.auth.token.email_verified == true &&
          request.auth.token.email in ['admin@vessel.network', 'ojitos@vessel.app', 'msambrenil@gmail.com']
        )
      );
    }

    // Almacenamiento multimedia de usuarios (avatares, álbumes y bóvedas cifradas)
    match /vessel_users/{userId}/{allPaths=**} {
      // Lectura autenticada para permitir visualización en la matriz y chats
      allow read: if isAuthenticated();
      // Escritura exclusiva del propietario o admin con límite de tamaño de 15MB
      allow write: if (isOwner(userId) || isAdmin()) && request.resource.size < 15 * 1024 * 1024;
    }

    // Denegación por defecto para cualquier otra ruta no especificada
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
